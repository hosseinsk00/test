# Database
DATABASE_URL="postgresql://username:password@localhost:5432/fleet_management?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key
REFRESH_TOKEN_EXPIRES_IN=7d

# WhatsApp API
WHATSAPP_API_KEY=jvbg3nw-g5yolcg-y4266kq-hzlll9g-gt1qq4w
WHATSAPP_API_BASE=https://api.whatsiplus.com

# OpenAI API
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Fuel Standard Consumption (liters per kilometer)
FUEL_STANDARD_CONSUMPTION=0.60
FUEL_ABNORMAL_THRESHOLD=100
